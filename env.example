
# Beispiel-Konfiguration für deinen StackEdit-Workspace mit eigener OAuth-Konfiguration

STACKEDIT_IMAGE=qmcgaw/stackedit
STACKEDIT_CONTAINER_NAME=stackedit
STACKEDIT_PORT=3030
STACKEDIT_NETWORK=highfishNetwork
STACKEDIT_ROOT_URL=/
STACKEDIT_USER_BUCKET_NAME=stackedit-users

# OAuth: eigene Credentials eintragen
GOOGLE_CLIENT_ID=deine-google-client-id
GOOGLE_API_KEY=dein-google-api-key
GITHUB_CLIENT_ID=deine-github-client-id
GITHUB_CLIENT_SECRET=dein-github-client-secret
